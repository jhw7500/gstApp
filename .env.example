# 호스트별 빌드 경로. 이 파일을 .env 로 복사해 채운다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 한 줄에 KEY=VALUE 하나. 따옴표와 공백 없이 쓴다 (Makefile 과 셸이 함께 읽는다).

# 주의 — make 가 이 파일을 makefile 소스로 읽는다 (`-include .env`).
# 셸 파서와 달리 make 쪽에는 키 화이트리스트가 없다. 아래 키만 KEY=VALUE 로 적고,
# 다른 줄은 넣지 않는다. `KEY: value` 같은 오타는 기본 빌드 타깃을 바꾸고,
# `$(shell ...)` 는 make 파싱 시점에 실행된다.

# Yocto SDK 설치 위치. ${SDK_LOC}/environment-setup-${SDK_NAME} 이 있어야 한다.
SDK_LOC=
SDK_NAME=cortexa53-crypto-poky-linux

# rnnoise 설치 루트 — 하위에 lib/ 와 include/ 가 있어야 한다.
# 비우면 -lrnnoise 링크와 include 경로를 모두 생략한다.
RNNOISE_DIR=
